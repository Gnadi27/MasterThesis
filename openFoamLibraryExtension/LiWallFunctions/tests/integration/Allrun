#!/bin/sh

. /opt/of-v2412/etc/bashrc
set -eu

testDir="$(cd "$(dirname "$0")" && pwd)"
caseDir="$testDir/isothermal"
isoDir="/tmp/LiWallFunctionIntegration-isothermal-$$"
adiabaticDir="/tmp/LiWallFunctionIntegration-adiabatic-$$"
viscousDir="/tmp/LiWallFunctionIntegration-viscous-$$"
thermoDir="/tmp/LiWallFunctionIntegration-janafPolynomial-$$"
parallelDir="/tmp/LiWallFunctionIntegration-parallel-$$"
neumannDir="/tmp/LiWallFunctionIntegration-neumann-$$"
neumannAdiabaticDir="/tmp/LiWallFunctionIntegration-neumannAdiabatic-$$"
neumannParallelDir="/tmp/LiWallFunctionIntegration-neumannParallel-$$"

configureNeumannIsothermal()
{
    # Milder inflow than the alphat cases: the prescribed-gradient coupling
    # imposes the flux without matrix feedback, and this deliberately crude
    # startup field would otherwise demand an unphysical face state.
    foamDictionary "$1/0/U" -entry internalField \
        -set 'uniform (200 0 0)' >/dev/null
    foamDictionary "$1/0/U" -entry boundaryField.inlet.value \
        -set 'uniform (200 0 0)' >/dev/null
    foamDictionary "$1/0/T" -entry internalField -set 'uniform 500' >/dev/null
    foamDictionary "$1/0/T" -entry boundaryField.inlet.value \
        -set 'uniform 500' >/dev/null
    foamDictionary "$1/0/T" -entry boundaryField.wall -set \
        '{type LiNeumannWallHeatFluxTemperature; thermalMode isothermal;
          Tw 350; wallTransport {mode sutherland; As 1.458e-06; Ts 110.4;}
          gradientRelaxation 0.3; TFaceMin 100;
          diagnostics true; diagnosticLog true; diagnosticWrite true;
          diagnosticWriteInterval 50; value uniform 350;}' >/dev/null
    foamDictionary "$1/0/alphat" -entry boundaryField.wall \
        -set '{type fixedValue; value uniform 0;}' >/dev/null
    foamDictionary "$1/0/nut" -entry boundaryField.wall -set \
        '{type nutLiNeumannWallFunction; thermalMode isothermal; Tw 350;
          wallTransport {mode sutherland; As 1.458e-06; Ts 110.4;}
          value uniform 0;}' >/dev/null
    foamDictionary "$1/0/nuTilda" -entry boundaryField.wall -set \
        '{type nuTildaLiNeumannWallFunction; thermalMode isothermal; Tw 350;
          wallTransport {mode sutherland; As 1.458e-06; Ts 110.4;}
          value uniform 0;}' >/dev/null
    foamDictionary "$1/system/controlDict" -entry endTime -set 200 >/dev/null
    foamDictionary "$1/system/controlDict" -entry writeInterval \
        -set 200 >/dev/null
    foamDictionary "$1/system/fvSolution" \
        -entry relaxationFactors.equations.h -set 0.4 >/dev/null
}

mkdir -p "$isoDir"
cp -R "$caseDir/0" "$caseDir/constant" "$caseDir/system" "$isoDir/"

blockMesh -case "$isoDir"
rhoSimpleFoam -case "$isoDir"

test -f "$isoDir/postProcessing/LiWallFunctionDiagnostics/wall/3.dat"
grep -q "thermalFluxTarget = qHalf" \
    "$isoDir/postProcessing/LiWallFunctionDiagnostics/wall/3.dat"

mkdir -p "$adiabaticDir"
cp -R "$caseDir/0" "$caseDir/constant" "$caseDir/system" "$adiabaticDir/"
foamDictionary "$adiabaticDir/0/T" \
    -entry boundaryField.wall.type -set zeroGradient >/dev/null
foamDictionary "$adiabaticDir/0/alphat" \
    -entry boundaryField.wall.thermalMode -set adiabatic >/dev/null
foamDictionary "$adiabaticDir/0/alphat" \
    -entry boundaryField.wall.thermalFluxTarget -set qw >/dev/null
foamDictionary "$adiabaticDir/0/nuTilda" \
    -entry boundaryField.wall.thermalMode -set adiabatic >/dev/null

blockMesh -case "$adiabaticDir"
rhoSimpleFoam -case "$adiabaticDir"

test -f "$adiabaticDir/postProcessing/LiWallFunctionDiagnostics/wall/3.dat"
grep -q "thermalFluxTarget = qw" \
    "$adiabaticDir/postProcessing/LiWallFunctionDiagnostics/wall/3.dat"
awk '!/^#/ && $13 > 30 {found=1} END {exit !found}' \
    "$adiabaticDir/postProcessing/LiWallFunctionDiagnostics/wall/1.dat"

mkdir -p "$viscousDir"
cp -R "$adiabaticDir/0" "$adiabaticDir/constant" "$adiabaticDir/system" \
    "$viscousDir/"
foamDictionary "$viscousDir/0/U" -entry internalField \
    -set 'uniform (50 0 0)' >/dev/null
foamDictionary "$viscousDir/0/U" -entry boundaryField.inlet.value \
    -set 'uniform (50 0 0)' >/dev/null
blockMesh -case "$viscousDir" >/dev/null
rhoSimpleFoam -case "$viscousDir" >/dev/null
awk '!/^#/ && $13 > 10 {exit 1}' \
    "$viscousDir/postProcessing/LiWallFunctionDiagnostics/wall/1.dat"

mkdir -p "$thermoDir"
cp -R "$caseDir/0" "$caseDir/constant" "$caseDir/system" "$thermoDir/"
cp "$testDir/janafPolynomialThermophysicalProperties" \
    "$thermoDir/constant/thermophysicalProperties"
foamDictionary "$thermoDir/system/controlDict" -entry libs \
    -set '("libmyThermos.so" "libLiWallFunctions.so")' >/dev/null
blockMesh -case "$thermoDir" >/dev/null
rhoSimpleFoam -case "$thermoDir" >/dev/null
test -f "$thermoDir/postProcessing/LiWallFunctionDiagnostics/wall/3.dat"

if command -v mpirun >/dev/null 2>&1
then
    mkdir -p "$parallelDir"
    cp -R "$caseDir/0" "$caseDir/constant" "$caseDir/system" "$parallelDir/"
    blockMesh -case "$parallelDir" >/dev/null
    decomposePar -case "$parallelDir" >/dev/null
    mpirun --oversubscribe -np 2 \
        rhoSimpleFoam -parallel -case "$parallelDir" >/dev/null
fi

# --- LiNeumann variant: prescribed-gradient (Neumann) energy coupling ---

mkdir -p "$neumannDir"
cp -R "$caseDir/0" "$caseDir/constant" "$caseDir/system" "$neumannDir/"
configureNeumannIsothermal "$neumannDir"

blockMesh -case "$neumannDir" >/dev/null
rhoSimpleFoam -case "$neumannDir" >/dev/null

neumannDat="$neumannDir/postProcessing/LiNeumannWallFunctionDiagnostics/wall/200.dat"
test -f "$neumannDat"
grep -q "thermalFluxTarget = qw" "$neumannDat"
# The wall function evaluated (status 0) and extracts heat on some faces.
awk '!/^#/ && $6 == 0 && $23 > 0 {found=1} END {exit !found}' "$neumannDat"
# Face temperatures stayed inside the clamp envelope and finite.
awk '!/^#/ && ($30 < 99.99 || $30 > 1000) {bad=1} END {exit bad}' "$neumannDat"

mkdir -p "$neumannAdiabaticDir"
cp -R "$caseDir/0" "$caseDir/constant" "$caseDir/system" "$neumannAdiabaticDir/"
foamDictionary "$neumannAdiabaticDir/0/T" -entry boundaryField.wall -set \
    '{type LiNeumannWallHeatFluxTemperature; thermalMode adiabatic;
      diagnostics true; diagnosticLog true; diagnosticWrite true;
      value uniform 900;}' >/dev/null
foamDictionary "$neumannAdiabaticDir/0/alphat" -entry boundaryField.wall \
    -set '{type fixedValue; value uniform 0;}' >/dev/null
foamDictionary "$neumannAdiabaticDir/0/nut" -entry boundaryField.wall -set \
    '{type nutLiNeumannWallFunction; thermalMode adiabatic; value uniform 0;}' \
    >/dev/null
foamDictionary "$neumannAdiabaticDir/0/nuTilda" -entry boundaryField.wall -set \
    '{type nuTildaLiNeumannWallFunction; thermalMode adiabatic;
      value uniform 0;}' >/dev/null

blockMesh -case "$neumannAdiabaticDir" >/dev/null
rhoSimpleFoam -case "$neumannAdiabaticDir" >/dev/null

neumannAdiabaticDat="$neumannAdiabaticDir/postProcessing/LiNeumannWallFunctionDiagnostics/wall/3.dat"
test -f "$neumannAdiabaticDat"
# Adiabatic mode must reduce to zeroGradient: gradT and qTargetOF are zero.
awk '!/^#/ && ($29 != 0 || $33 != 0) {bad=1} END {exit bad}' \
    "$neumannAdiabaticDat"

if command -v mpirun >/dev/null 2>&1
then
    mkdir -p "$neumannParallelDir"
    cp -R "$neumannDir/0" "$neumannDir/constant" "$neumannDir/system" \
        "$neumannParallelDir/"
    foamDictionary "$neumannParallelDir/system/controlDict" -entry endTime \
        -set 50 >/dev/null
    blockMesh -case "$neumannParallelDir" >/dev/null
    decomposePar -case "$neumannParallelDir" >/dev/null
    mpirun --oversubscribe -np 2 \
        rhoSimpleFoam -parallel -case "$neumannParallelDir" >/dev/null
fi

echo "Li wall-function viscous/log, isothermal, adiabatic, variable-property, parallel, and LiNeumann smoke tests passed"
