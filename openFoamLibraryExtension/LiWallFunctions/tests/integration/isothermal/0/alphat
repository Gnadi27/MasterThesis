FoamFile
{
    format      ascii;
    class       volScalarField;
    object      alphat;
}

dimensions [1 -1 -1 0 0 0 0];
internalField uniform 0;

boundaryField
{
    inlet { type calculated; value uniform 0; }
    outlet { type calculated; value uniform 0; }
    wall
    {
        type compressible::alphatLiWallFunction;
        thermalMode isothermal;
        thermalFluxTarget qHalf;
        diagnostics true;
        diagnosticLog true;
        diagnosticWrite true;
        value uniform 0;
    }
    top { type symmetryPlane; }
    frontAndBack { type empty; }
}
