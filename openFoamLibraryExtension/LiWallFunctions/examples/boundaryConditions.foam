// Load in system/controlDict (and libmyThermos.so when using the local
// polynomialTransport thermodynamics):
libs
(
    "libLiWallFunctions.so"
);

// 0/nut
wall
{
    type        nutLiWallFunction;
    value       uniform 0;
}

// 0/alphat
wall
{
    type        compressible::alphatLiWallFunction;
    thermalMode auto;
    // auto selects qHalf for fixed-temperature walls and qw=0 for adiabatic.
    thermalFluxTarget auto;
    diagnostics false;
    value       uniform 0;
}

// 0/nuTilda (Spalart-Allmaras only)
wall
{
    type        nuTildaLiWallFunction;
    thermalMode auto;
    value       uniform 0;
}

// Shared optional entries accepted by all three conditions:
// kappa          0.41;
// B              6.0;
// Prt            0.9;
// omegaH         0.72;
// cv1            7.1;
// enthalpyOffset 0;
// maxIter        80;
// tolerance      1e-8;
// strict         false;


// ---------------------------------------------------------------------------
// LiNeumann variant: prescribed-gradient (Neumann) energy coupling.
// The Li heat flux is imposed directly through the T boundary condition;
// alphat becomes a trivial fixedValue 0. Use this instead of the alphat
// coupling for walls near recovery temperature at coarse y+ (T_1 < T_w),
// where the alphat inversion is structurally unrepresentable.
//
// WARNING: under LiNeumannWallHeatFluxTemperature the patch T value is the
// tangent-extrapolated face temperature, NOT the physical wall temperature.
// Tw lives in the coefficients below (and in the diagnostics output).
// All three conditions must carry identical coefficients, including Tw and
// wallTransport.

// 0/T
wall
{
    type        LiNeumannWallHeatFluxTemperature;
    thermalMode isothermal;         // or adiabatic (== zeroGradient)
    Tw          300;                // physical wall temperature [K]
    wallTransport
    {
        mode    sutherland;         // or constant (mu/kappa entries)
        As      1.458e-06;
        Ts      110.4;
        // Pr   0.72;               // optional; omitted -> modified Eucken
    }
    // auto selects the physical wall flux qw (qHalf remains available as a
    // legacy/diagnostic target).
    thermalFluxTarget auto;
    // Startup/stability aids (optional):
    // gradientRelaxation 0.3;      // under-relax the gradient update
    // TFaceMin           100;      // clamp the extrapolated face T [K]
    // TFaceMax           5000;
    diagnostics false;
    value       uniform 300;        // initial face value only
}

// 0/alphat
wall
{
    type        fixedValue;
    value       uniform 0;
}

// 0/nut
wall
{
    type        nutLiNeumannWallFunction;
    thermalMode isothermal;
    Tw          300;
    wallTransport
    {
        mode    sutherland;
        As      1.458e-06;
        Ts      110.4;
    }
    value       uniform 0;
}

// 0/nuTilda (Spalart-Allmaras only)
wall
{
    type        nuTildaLiNeumannWallFunction;
    thermalMode isothermal;
    Tw          300;
    wallTransport
    {
        mode    sutherland;
        As      1.458e-06;
        Ts      110.4;
    }
    value       uniform 0;
}
