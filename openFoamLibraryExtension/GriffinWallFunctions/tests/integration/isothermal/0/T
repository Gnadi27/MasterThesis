FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions [0 0 0 1 0 0 0];
internalField uniform 500;

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform 500;
    }
    outlet
    {
        type zeroGradient;
    }
    wall
    {
        type            GriffinWallHeatFluxTemperature;
        thermalMode     isothermal;
        Tw              350;
        viscosity
        {
            mode        sutherland;
            As          1.458e-06;
            Ts          110.4;
        }
        gradientRelaxation 0.3;
        TFaceMin        100;
        diagnostics     true;
        diagnosticLog   true;
        diagnosticWrite true;
        diagnosticWriteInterval 50;
        value           uniform 350;
    }
    top
    {
        type symmetryPlane;
    }
    frontAndBack
    {
        type empty;
    }
}
