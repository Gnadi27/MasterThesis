FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}

dimensions [0 2 -1 0 0 0 0];
internalField uniform 0.0002;

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform 0.0002;
    }
    outlet
    {
        type zeroGradient;
    }
    wall
    {
        type            nuTildaGriffinWallFunction;
        thermalMode     isothermal;
        Tw              350;
        viscosity
        {
            mode        sutherland;
            As          1.458e-06;
            Ts          110.4;
        }
        value           uniform 0;
    }
    top { type symmetryPlane; }
    frontAndBack { type empty; }
}
