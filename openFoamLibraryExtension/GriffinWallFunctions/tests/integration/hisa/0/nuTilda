FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 3e-04;

boundaryField
{
    "(inlet|outlet|top)"
    {
        type            inletOutlet;
        value           uniform 3e-04;
        inletValue      uniform 3e-04;
    }
    wall
    {
        type            nuTildaGriffinWallFunction;
        thermalMode     isothermal;
        Tw              150;
        viscosity
        {
            mode        sutherland;
            As          1.458e-06;
            Ts          110.4;
        }
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}
