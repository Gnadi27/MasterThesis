FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    "(inlet|outlet|top)"
    {
        type            calculated;
        value           uniform 0;
    }
    wall
    {
        type            nutGriffinWallFunction;
        thermalMode     isothermal;
        Tw              150;
        viscosity
        {
            mode        sutherland;
            As          1.458e-06;
            Ts          110.4;
        }
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}
