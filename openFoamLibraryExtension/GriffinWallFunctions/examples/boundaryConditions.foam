// Griffin wall-function boundary-condition snippets (OpenFOAM v2412 + HiSA).
//
// Load the library in system/controlDict:
//     libs ("libGriffinWallFunctions.so");
//
// RULE: all three Griffin boundary conditions on a patch must carry
// IDENTICAL wall-function coefficients (Tw, viscosity, edge*, ...).
//
// The wall patch T under GriffinWallHeatFluxTemperature is the
// tangent-extrapolated face temperature, NOT the physical wall
// temperature; the physical wall state lives in the dictionary (Tw) and
// the diagnostics output.

// ---------------------------------------------------------------- 0/T
wall
{
    type            GriffinWallHeatFluxTemperature;
    thermalMode     isothermal;         // auto | isothermal | adiabatic
    Tw              300;                // physical wall temperature [K]
    viscosity                           // mu(T) law for the inner profile
    {
        mode        sutherland;         // sutherland | powerLaw | constant
        As          1.458e-06;
        Ts          110.4;
        // mode powerLaw;  muRef 1.716e-5;  TRef 273.15;  n 0.75;
        // mode constant;  mu 1.8e-05;
    }

    // Boundary-layer edge (defaults shown):
    edgeMode        reconstruct;        // reconstruct | prescribed
    // Ue 900; Te 60; delta 0.005;      // required for prescribed
    maxEdgeCells    200;
    edgeUpdateInterval 1;
    edgeThreshold   0.99;

    // Delivery/stabilization:
    gradientRelaxation 0.3;             // (0,1]; 1 = no relaxation
    TFaceMin        20;                 // face-T clamp; if it BINDS, the
    TFaceMax        5000;               // flux is not delivered - fix the
                                        // wall alphat conditioning instead

    // Per-face diagnostics -> postProcessing/GriffinWallFunctionDiagnostics/
    diagnostics     true;
    diagnosticLog   true;
    diagnosticWrite true;
    diagnosticWriteInterval 100;

    value           uniform 300;        // initial face value only
}

// Adiabatic variant (q_w = 0, T_w = T_r; reduces to zeroGradient):
// wall
// {
//     type            GriffinWallHeatFluxTemperature;
//     thermalMode     adiabatic;
//     value           uniform 300;
// }

// -------------------------------------------------------------- 0/nut
wall
{
    type            nutGriffinWallFunction;
    thermalMode     isothermal;
    Tw              300;
    viscosity
    {
        mode        sutherland;
        As          1.458e-06;
        Ts          110.4;
    }
    value           uniform 0;
}

// ---------------------------------------------------------- 0/nuTilda
wall
{
    type            nuTildaGriffinWallFunction;
    thermalMode     isothermal;
    Tw              300;
    viscosity
    {
        mode        sutherland;
        As          1.458e-06;
        Ts          110.4;
    }
    value           uniform 0;
}

// ------------------------------------------------------------ 0/alphat
// NOT a wall function: the energy coupling is Neumann-only. The value is
// pure conditioning (alphaEff cancels from the delivered flux); with 0
// the extrapolated face temperature can leave the physical range and the
// TFace clamp silently caps the delivered flux. 0.05 is a good default.
wall
{
    type            fixedValue;
    value           uniform 0.05;
}
